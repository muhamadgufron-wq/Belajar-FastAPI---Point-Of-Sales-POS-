# Ganti "password_kamu" dan "postgres" (nama db) sesuai settingan PostgreSQL kamu
DATABASE_URL=postgresql+psycopg://gufron:password_kamu@127.0.0.1:5432/postgres
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Superuser / Owner Seeder (Opsional)
FIRST_SUPERUSER_USERNAME=owner_neneng
FIRST_SUPERUSER_PASSWORD=OwnerNeneng123!
